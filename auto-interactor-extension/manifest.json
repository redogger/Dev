{
  "manifest_version": 3,
  "name": "Auto Interactor Pro",
  "version": "1.0.0",
  "description": "Chrome Extension متقدم للتفاعل التلقائي مع صفحات الويب - أتمتة المهام، استخراج البيانات، وملء النماذج تلقائياً",
  
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "alarms",
    "contextMenus"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Auto Interactor Pro"
  },
  
  "options_page": "options/options.html",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["scripts/*.js", "utils/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "externally_connectable": {
    "matches": ["<all_urls>"]
  }
}
